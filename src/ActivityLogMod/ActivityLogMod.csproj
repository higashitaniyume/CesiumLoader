<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ActivityLogMod</AssemblyName>
    <RootNamespace>ActivityLogMod</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK: 事件系统 / 数据访问 / 名字解析 / 生命周期 -->
    <ProjectReference Include="..\CesiumLoader.SDK\CesiumLoader.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 游戏热更程序集: 业务代码直接用的类型(RoomInfo / RoomPlayer / Battle / CardInfo / party.model) -->
    <Reference Include="AstralParty.Runtime">
      <HintPath>..\..\..\..\extracted_dlls\AstralParty.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>..\..\..\..\extracted_dlls\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf.Runtime">
      <HintPath>..\..\..\..\extracted_dlls\Google.Protobuf.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
