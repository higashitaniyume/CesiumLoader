      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{A7B3E5D1-9C2F-4E8B-8D4A-1F3C9B7E5A22}</ProjectGuid>
    <RootNamespace>CesiumLoader</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>CesiumLoader</ProjectName>
  </PropertyGroup>
  <!-- 第三方依赖全部 **源码入库(vendored)**, 见 ..\..\third_party\README.md —— 不用包管理器:
       拉下仓库直接 msbuild 就能编, 本机和 CI 都不需要 vcpkg(命令行 msbuild 并不会自动发现 vcpkg,
       runner 是全新环境, 每个 runner 都得现装一遍依赖)。
         fmt            header-only(下方 FMT_HEADER_ONLY), 不产生也不需要任何 .lib
         spdlog         header-only(不定义 SPDLOG_COMPILED_LIB); 它的 tweakme.h 里写死了
                        SPDLOG_FMT_EXTERNAL, 即 spdlog 用的就是我们这份 fmt —— 只有一份 fmt, 不存在混用
         nlohmann/json  单头文件
       本 DLL 是加载器核心(CesiumLoader.dll), 由薄代理 version.dll 在游戏进程里加载,
       这些库必须全是静态/内联的, 绝不能要求额外的 spdlog.dll / fmt.dll 一起分发。
       注意本工程**不是**代理: 代理是 loader\CesiumLoader.Proxy(产出 version.dll),
       两侧只共用 loader\shared\cesium_core_abi.h 这一份契约头, 互不引用源码。
       路径一律用相对路径: 直接 msbuild 这个 vcxproj 时 $(SolutionDir) 不可靠。 -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <Target Name="GenerateCesiumBuildInfo" BeforeTargets="ClCompile">
    <MakeDir Directories="$(IntDir)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\..\tools\generate-build-info.ps1&quot; -Output &quot;$(IntDir)build_info.generated.h&quot; -Repo &quot;$(ProjectDir)..\..&quot;" />
  </Target>
  <!-- OutDir / IntDir 故意用 $(ProjectDir) 相对路径, 不依赖 $(SolutionDir)(直接 msbuild 单个
       vcxproj 时 $(SolutionDir) 不可靠), 而且必须与代理工程 CesiumLoader.Proxy 落在同一个
       目录 —— "核心与 version.dll 同目录" 是契约的一部分, 见 loader\shared\cesium_core_abi.h。 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <LinkIncremental>true</LinkIncremental>
    <OutDir>$(ProjectDir)..\..\bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\..\obj\$(ProjectName)\$(Configuration)\</IntDir>
    <TargetName>CesiumLoader</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(ProjectDir)..\..\bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\..\obj\$(ProjectName)\$(Configuration)\</IntDir>
    <TargetName>CesiumLoader</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;_USRDLL;CESIUMLOADER_EXPORTS;SPDLOG_FMT_EXTERNAL;FMT_HEADER_ONLY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- 静态链接 CRT: Debug 用 /MTd (libcmtd 提供 _CrtDbgReport 等调试函数), Release 用 /MT。
           两者都不依赖 VC++ Redistributable; 与代理之间只传基本类型, 不跨 CRT 堆。 -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(IntDir);$(ProjectDir);$(ProjectDir)..\shared;..\..\third_party\fmt\include;..\..\third_party\nlohmann_json\include;..\..\third_party\spdlog\include;..\..\third_party\minhook\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <AdditionalDependencies>winmm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;_USRDLL;CESIUMLOADER_EXPORTS;SPDLOG_FMT_EXTERNAL;FMT_HEADER_ONLY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- 静态链接 CRT (libcmt/libcpmt/libucrt): 运行时不依赖 VC++ Redistributable。
           老系统只需 Win10/11 自带组件即可加载; 与代理之间只传基本类型, 不跨 CRT 堆。 -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <Optimization>MaxSpeed</Optimization>
      <SpectreMitigation>Spectre</SpectreMitigation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(IntDir);$(ProjectDir);$(ProjectDir)..\shared;..\..\third_party\fmt\include;..\..\third_party\nlohmann_json\include;..\..\third_party\spdlog\include;..\..\third_party\minhook\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <AdditionalDependencies>winmm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
