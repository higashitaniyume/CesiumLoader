<Window x:Class="CesiumLoader.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cesium Overlay"
        Width="380" Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Window.Resources>
        <Style x:Key="PeekCard" TargetType="Border">
            <Setter Property="Background" Value="#D90D1218"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="HeaderBar" TargetType="Grid">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style x:Key="ChevronButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Grid.LayoutTransform>
        <StackPanel>
            <!-- 顶部工具条（整体收起 / 点击穿透提示） -->
            <Border Background="#E60D1218" CornerRadius="6" Padding="8,3" Margin="0,0,0,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◈" Foreground="#FFD24A" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text=" 商店 · 筹码 " Foreground="White" FontSize="11" VerticalAlignment="Center" Opacity="0.85"/>
                    </StackPanel>
                    <Button x:Name="CollapseAllBtn" Content="收起" Width="48" Height="22" HorizontalAlignment="Right"
                            Background="#2AFFFFFF" Foreground="White" BorderThickness="0" FontSize="11" Cursor="Hand"
                            Click="CollapseAll_Click"/>
                </Grid>
            </Border>

            <!-- 商店卡片 -->
            <Border x:Name="ShopCard" Style="{StaticResource PeekCard}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="ShopHeader_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🛒 商店看板" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,5,0,5"/>
                        <TextBlock x:Name="ShopCount" Text="" Foreground="#B0FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" Grid.Column="1"/>
                        <Button x:Name="ShopChevronBtn" Grid.Column="2" Content="▾" Style="{StaticResource ChevronButton}" Click="ShopHeader_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="8,6,8,8">
                        <RichTextBox x:Name="ShopText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     Foreground="White" SelectionBrush="Transparent" Padding="0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 筹码卡片 -->
            <Border x:Name="RelicCard" Style="{StaticResource PeekCard}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="RelicHeader_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="✦ 筹码看板" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,5,0,5"/>
                        <TextBlock x:Name="RelicCount" Text="" Foreground="#B0FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" Grid.Column="1"/>
                        <Button x:Name="RelicChevronBtn" Grid.Column="2" Content="▾" Style="{StaticResource ChevronButton}" Click="RelicHeader_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="8,6,8,8">
                        <RichTextBox x:Name="RelicText" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     Foreground="White" SelectionBrush="Transparent" Padding="0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 全部收起后的迷你条 -->
            <Border x:Name="MiniPill" Background="#D90D1218" CornerRadius="12" Padding="10,4" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MiniText" Text="🛒 ✦" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                    <Button Content="展开" Margin="8,0,0,0" Background="#2AFFFFFF" Foreground="White" BorderThickness="0" FontSize="11" Width="42" Height="20" Cursor="Hand" Click="ExpandAll_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="HintText" Text="反斜杠(\) 切换穿透 · 拖工具条移位 · 点标题可收起" Foreground="#88FFFFFF" FontSize="10" Margin="2,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
