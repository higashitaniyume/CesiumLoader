{
  // 总开关：是否在右上角显示商店与筹码看板
  "enabled": true,
  // 文本字号，范围 12–36，默认 18
  "fontSize": 18,
  // 一键清空看板内容的快捷键，默认 T
  "clearKey": "T",
  // 渲染后端：internal=游戏内，wpf=进程外 WPF Overlay（需 CESIUM_OVERLAY_PORT）
  "backend": "internal",
  // 玩家名字前是否显示楼层标签（如【一楼】）
  "showFloorTag": true,

  // ---- 商店独立看板 ----
  // 是否显示有人走到商店时遇到的货架卡牌
  "showShopCards": true,
  // 商店看板宽度（像素），默认 340
  "shopPanelWidth": 340.0,
  // 商店看板距离屏幕右边缘的偏移（像素），默认 20
  "shopOffsetX": 20.0,
  // 商店看板距离屏幕上边缘的偏移（像素），默认 70
  "shopOffsetY": 70.0,
  // 离开商店后卡牌保持显示的秒数，默认 20 秒
  "shopDisplayDurationSeconds": 20,

  // ---- 筹码独立看板 ----
  // 是否显示选筹码时的候选筹码、刷新历史及最终选定
  "showRelicCandidates": true,
  // 筹码看板宽度（像素），默认 340
  "relicPanelWidth": 340.0,
  // 筹码看板距离屏幕右边缘的偏移（像素），默认 20
  "relicOffsetX": 20.0,
  // 筹码看板距离屏幕上边缘的偏移（像素），默认 320（位于商店看板下方，且自动避让商店不遮挡）
  "relicOffsetY": 320.0,
  // 选定筹码后结果保持显示的秒数，默认 20 秒（防止瞬间消失）
  "relicDisplayDurationSeconds": 20,
  // 筹码名称是否按品质着色（普通蓝/稀有紫/传说橙）
  "colorRelicByQuality": true,

