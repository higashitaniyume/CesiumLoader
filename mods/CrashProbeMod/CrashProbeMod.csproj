<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CrashProbeMod</AssemblyName>
    <RootNamespace>CrashProbeMod</RootNamespace>
    <!-- 故意写非法指针验证原生访问冲突, 必须允许 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\loader\CesiumLoader.SDK\CesiumLoader.SDK.csproj" />
    <!-- UIManager / SettingWindow(设置页检测) -->
    <Reference Include="AstralParty.Runtime"><HintPath>$(GameRefsDir)AstralParty.Runtime.dll</HintPath><Private>false</Private></Reference>
    <!-- KeyCode / 输入 -->
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameRefsDir)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <None Update="CrashProbeMod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
