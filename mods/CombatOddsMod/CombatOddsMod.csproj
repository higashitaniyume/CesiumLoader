<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CombatOddsMod</AssemblyName>
    <RootNamespace>CombatOddsMod</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);COMBATODDS_DEBUG_PROBES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK: 事件系统 / 数据访问 / 名字解析 / UI 登记 / 生命周期 -->
    <ProjectReference Include="..\..\loader\CesiumLoader.SDK\CesiumLoader.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 游戏热更程序集: 直接用的类型(party.model.Battle / BattleRole / BattlePlayerData 等) -->
    <Reference Include="AstralParty.Runtime">
      <HintPath>$(GameRefsDir)AstralParty.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(GameRefsDir)UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf.Runtime">
      <HintPath>$(GameRefsDir)Google.Protobuf.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRefsDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- sidecar: 随 dll 一起进构建输出, 便于部署/打包(与 FreeCameraMod 一致) -->
    <None Update="CombatOddsMod.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
