<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>AstralParty.AgentMod.Tests</AssemblyName>
    <RootNamespace>AstralParty.AgentMod.Tests</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- CesiumJson: 桥接的命令/结果/状态 JSON 都走 SDK 的这一套读写器 -->
    <ProjectReference Include="..\..\loader\CesiumLoader.SDK\CesiumLoader.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 桥接里的"纯逻辑"直接编进测试程序集(它们本身不碰游戏类型, 所以离线可测)。
         路径深度与 CesiumLoader.SDK.csproj 一致(4 级回仓库根)。 -->
    <Compile Include="..\..\mcp\Shared\AgentBridgeLayout.cs" Link="Bridge\AgentBridgeLayout.cs" />
    <Compile Include="..\..\mcp\AstralParty.AgentMod\Bridge\AgentStateModels.cs" Link="Bridge\AgentStateModels.cs" />
    <Compile Include="..\..\mcp\AstralParty.AgentMod\Bridge\PendingTracker.cs" Link="Bridge\PendingTracker.cs" />
    <Compile Include="..\..\mcp\AstralParty.AgentMod\Bridge\CommandParser.cs" Link="Bridge\CommandParser.cs" />
    <Compile Include="..\..\mcp\AstralParty.AgentMod\Bridge\BridgeSettings.cs" Link="Bridge\BridgeSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 CesiumLoader.SDK.Tests 同样的补齐: SDK 程序集里有引用 UniTask / UnityEngine 的类型,
         测试进程加载 SDK 程序集时需要能解析它们。 -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\..\extracted_dlls\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>..\..\..\..\extracted_dlls\UniTask.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
