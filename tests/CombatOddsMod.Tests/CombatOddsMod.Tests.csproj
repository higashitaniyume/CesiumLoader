<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>CombatOddsMod.Tests</AssemblyName>
    <RootNamespace>CombatOddsMod.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接编译 mod 里的纯计算核心(零游戏/SDK 依赖), 离线可测, 不引入任何游戏 DLL。 -->
    <Compile Include="..\..\mods\CombatOddsMod\CombatMath.cs" Link="CombatMath.cs" />
    <!-- 覆盖层编排逻辑(纯 System, 用假反射器单测状态机)。 -->
    <Compile Include="..\..\mods\CombatOddsMod\FightOverlay.cs" Link="FightOverlay.cs" />
    <!-- 星币锤/手电筒/美工刀 的攻击力加成计算(纯逻辑, 零游戏依赖)。 -->
    <Compile Include="..\..\mods\CombatOddsMod\RelicAtkBonus.cs" Link="RelicAtkBonus.cs" />
    <!-- 技能冷却表(纯逻辑: 帧取值规则 + 按玩家维护, 零游戏依赖)。 -->
    <Compile Include="..\..\mods\CombatOddsMod\SkillCooldownTable.cs" Link="SkillCooldownTable.cs" />
    <!-- 怪物主动技能冷却的按轮推算(纯逻辑, 零游戏依赖)。 -->
    <Compile Include="..\..\mods\CombatOddsMod\MonsterCooldownTable.cs" Link="MonsterCooldownTable.cs" />
    <!-- 技能冷却会话(纯逻辑: 回合帧/释放技能/冷却修正 -> 剩余值与上限, 零游戏依赖)。 -->
    <Compile Include="..\..\mods\CombatOddsMod\SkillCooldownSession.cs" Link="SkillCooldownSession.cs" />
    <!-- 冷却文本("CD 剩余/上限")。 -->
    <Compile Include="..\..\mods\CombatOddsMod\SkillCooldownText.cs" Link="SkillCooldownText.cs" />
    <!-- 回调链包装策略(纯逻辑: 只装一次、包装捕获原始委托, 零游戏依赖)。 -->
    <Compile Include="..\..\mods\CombatOddsMod\HookChain.cs" Link="HookChain.cs" />
    <!-- 剩余手牌数的取值口径与图标地址解析(纯逻辑, 零游戏依赖)。 -->
    <Compile Include="..\..\mods\CombatOddsMod\HandCountRules.cs" Link="HandCountRules.cs" />
  </ItemGroup>

</Project>
